{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Read(./.vercel/**)",
      "Edit(./.vercel/**)",
      "Write(./.vercel/**)",
      "Edit(./ESPECIFICACION.md)",
      "Write(./ESPECIFICACION.md)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "ask": [
      "Edit(./pruebas/**)",
      "Write(./pruebas/**)",
      "Edit(./HALLAZGOS.md)",
      "Write(./HALLAZGOS.md)",
      "Bash(git push*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/verificar.sh"
          }
        ]
      }
    ]
  }
}
